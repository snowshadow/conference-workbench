HOST=127.0.0.1
PORT=8797
WORKBENCH_DATA_DIR=./data
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_ACCESS_KEY=
# 实时识别与文件识别默认使用豆包语音 2.0。
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
FILE_ASR_PROVIDER=volcengine
FILE_ASR_RESOURCE_ID=volc.seedasr.auc
# 文件转录复用上方语音凭证；需开通录音文件识别 2.0。
# 标准版自动使用私有 TOS 临时存储；配置步骤见 docs/TOS_SETUP.md。
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=
# 以下仅用于 FILE_ASR_PROVIDER=openai 的 OpenAI 兼容备用服务。
FILE_ASR_BASE_URL=http://127.0.0.1:8000
FILE_ASR_MODEL=Qwen3-ASR-1.7B-8bit
FILE_ASR_API_KEY=
FILE_ASR_LANGUAGE=zh
